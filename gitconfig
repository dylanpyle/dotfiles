[alias]
  br = for-each-ref --sort=-committerdate refs/heads/ --format='%(color:black)%(committerdate:short) %(color:blue)%(refname:short) %(color:black)%(authorname)' --count=20 --no-merge
  pending = log origin/production..origin/main --merges --pretty=format:'%b (%an)'
  st = status
  ci = commit
  c = checkout
  co = checkout
  df = diff
  lg = log -p
  rb = rebase
  d = difftool
  s = diff --stat main
  ds = diff --stat
  db = branch -D
  versions = tag --sort=-v:refname
[push]
  default = current
[core]
  excludesFile = ~/.gitignore_global
  ignorecase = false
[diff]
  tool = vimdiff
  algorithm = histogram
  colorMoved = plain
  mnemonicPrefix = true
  renames = true
[difftool]
  prompt = false
  trustExitCode = true
[pull]
  default = current
[protocol]
  version = 2
[user]
  useConfigOnly = true
  email = me@dylanpyle.com
  name = Dylan Pyle
  signingkey = 11111111
[init]
  defaultBranch = main
[branch]
  sort = -committerdate
[column]
  ui = auto
[fetch]
  prune = true
  pruneTags = true
  all = true
